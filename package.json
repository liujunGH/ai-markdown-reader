{
  "name": "markdown-reader",
  "private": true,
  "version": "2.1.0",
  "description": "A Markdown Reader",
  "author": "liujun",
  "main": "dist-electron/electron/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:compile": "tsc -p electron/tsconfig.json",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && npm run electron:compile && electron .\"",
    "electron:preview": "npm run electron:compile && npm run build && electron .",
    "electron:build": "npm run electron:compile && npm run build && electron-builder --win",
    "electron:build:mac": "npm run electron:compile && npm run build && electron-builder --mac",
    "electron:build:linux": "npm run electron:compile && npm run build && electron-builder --linux",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "perf:startup": "npm run electron:compile && npm run build && node scripts/perf-startup.mjs",
    "perf:document": "npm run electron:compile && npm run build && node scripts/perf-document.mjs",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.8",
    "better-sqlite3": "^13.0.2",
    "dompurify": "^3.4.12",
    "electron-updater": "^6.8.9",
    "i18next": "^26.0.8",
    "i18next-browser-languagedetector": "^8.2.1",
    "immer": "^11.1.4",
    "katex": "^0.16.45",
    "markdown-it": "^14.3.0",
    "markdown-it-emoji": "^3.0.0",
    "markdown-it-texmath": "^1.0.0",
    "mermaid": "^10.9.6",
    "prismjs": "^1.29.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^17.0.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/dompurify": "^3.0.5",
    "@types/katex": "^0.16.8",
    "@types/markdown-it": "^14.0.0",
    "@types/markdown-it-emoji": "^3.0.1",
    "@types/prismjs": "^1.26.3",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/ui": "^4.1.10",
    "concurrently": "^9.2.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.0",
    "typescript": "^5.3.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "wait-on": "^9.0.10",
    "ws": "^8.20.0"
  },
  "build": {
    "extends": "./electron-builder.yml"
  },
  "allowScripts": {
    "better-sqlite3@13.0.2": true
  }
}
